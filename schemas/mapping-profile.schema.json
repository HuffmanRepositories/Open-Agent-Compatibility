{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuffmanRepositories/Open-Agent-Compatibility/blob/main/schemas/mapping-profile.schema.json",
  "title": "Open Agent Compatibility Mapping Profile",
  "description": "Version-scoped, feature-level record of a proposed or assessed source-to-target compatibility mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "status",
    "assessment_date",
    "source",
    "target",
    "direction",
    "features",
    "review"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "illustrative",
        "draft",
        "reviewed",
        "validated"
      ]
    },
    "assessment_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source": {
      "$ref": "#/$defs/project"
    },
    "target": {
      "$ref": "#/$defs/project"
    },
    "direction": {
      "enum": [
        "source-to-target",
        "target-to-source",
        "bidirectional"
      ]
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewers",
        "reviewed_at"
      ],
      "properties": {
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "version",
        "references"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "source_concept",
        "target_concept",
        "outcome",
        "transformation",
        "losses",
        "constraints",
        "evidence_level",
        "tests",
        "notes"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "source_concept": {
          "type": "string",
          "minLength": 1
        },
        "target_concept": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "direct",
            "transformed",
            "partial",
            "lossy",
            "ambiguous",
            "unsupported",
            "not-tested"
          ]
        },
        "transformation": {
          "type": [
            "string",
            "null"
          ]
        },
        "losses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
